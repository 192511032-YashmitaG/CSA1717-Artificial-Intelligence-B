  "task5": {
    "fol": [
      "forall e,d: Handles(e,d) AND Restricted(d) -> Authorised(e)",
      "forall d: PatientData(d) -> Restricted(d)",
      "exists e: Employee(e) AND forall d: Audited(d) -> Handles(e,d)",
      "PatientData(R1)",
      "Audited(R1)"
    ],
    "cnf": [
      "~Handles(e,d) OR ~Restricted(d) OR Authorised(e)",
      "~PatientData(d) OR Restricted(d)",
      "Employee(sk_e)",
      "~Audited(d) OR Handles(sk_e,d)",
      "PatientData(R1)",
      "Audited(R1)"
    ],
    "skolemisation": "The existential employee is represented by a fresh Skolem constant sk_e. Skolemisation preserves satisfiability, not equivalence of the original formulas.",
    "proof_trace": [
      "1. Employee(sk_e)  (Skolem constant for the existential employee)",
      "2. PatientData(R1)  (fact)",
      "3. PatientData(R1) -> Restricted(R1)  (universal rule)",
      "4. Restricted(R1)  (resolution)",
      "5. Audited(R1)  (fact)",
      "6. Audited(R1) -> Handles(sk_e,R1)  (standardised universal instance)",
      "7. Handles(sk_e,R1)  (resolution)",
      "8. Handles(sk_e,R1) AND Restricted(R1) -> Authorised(sk_e)",
      "9. Authorised(sk_e)  (resolution)",
      "10. Therefore exists e: Authorised(e) by existential generalisation."
    ],
